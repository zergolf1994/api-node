# api-node configuration — copy to .env and fill in

# HTTP port (default: 8081)
PORT=8081

# HTTP timeout in seconds (default: 30)
HTTP_TIMEOUT=30

# MongoDB URI (required) — MONGODB_URI / MONGO_URI / DATABASE_URL
MONGODB_URI=mongodb+srv://user:pass@cluster.mongodb.net/vdohide

# Ably API key (optional) — realtime publish เมื่อสร้างไฟล์จาก /remote
# ว่าง = ปิด realtime (no-op). ต้องเป็น key เดียวกับฝั่งเว็บ
ABLY_API_KEY=

# Remote block (optional) — source URL ที่ import fail (scrape/access ไม่ได้)
# เกิน THRESHOLD ครั้ง → บล็อกชั่วคราว BLOCK_HOURS ชม. (พ้นแล้วลองใหม่ได้เอง)
REMOTE_FAIL_THRESHOLD=3
REMOTE_BLOCK_HOURS=24

# Storage (optional)
STORAGE_ID=
STORAGE_PATH=./files

# Scraper service URL (optional)
SCRAPER_URL=
